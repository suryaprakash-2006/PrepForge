# ============================================================
# PrepForge — .gitignore
# React/Vite (frontend) + FastAPI/Python (backend) + MongoDB
# ============================================================

# ------------------------------------------------------------
# ENVIRONMENT FILES
# NEVER commit real .env files containing secrets.
# .env.example IS intentionally tracked.
# ------------------------------------------------------------
.env
.env.*
!.env.example

# ------------------------------------------------------------
# PYTHON
# ------------------------------------------------------------
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Virtual environments — never commit these
.venv/
venv/
env/
ENV/
env.bak/
venv.bak/

# Distribution / packaging
dist/
build/
*.egg-info/
*.egg
.eggs/

# Testing & coverage
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# pyright
pyrightconfig.json

# ------------------------------------------------------------
# NODE / FRONTEND
# ------------------------------------------------------------
node_modules/
dist/
build/
.vite/
*.local

# npm / yarn / pnpm lock files (keep package-lock.json / yarn.lock tracked)
# Do NOT ignore lockfiles — they ensure reproducible installs

# ------------------------------------------------------------
# LOGS
# ------------------------------------------------------------
*.log
*.log.*
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ------------------------------------------------------------
# OS-GENERATED FILES
# ------------------------------------------------------------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini

# ------------------------------------------------------------
# IDE / EDITOR
# ------------------------------------------------------------

# VS Code — workspace settings may be committed if the team
# agrees; user-specific settings should not be.
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json

# JetBrains (PyCharm, WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.iws

# Vim / Neovim
*.swp
*.swo
*~

# Emacs
\#*\#
/.emacs.desktop
/.emacs.desktop.lock

# ------------------------------------------------------------
# TESTING
# ------------------------------------------------------------
.pytest_cache/
__snapshots__/

# ------------------------------------------------------------
# MISC
# ------------------------------------------------------------
# Temporary files
*.tmp
*.bak
*.orig
