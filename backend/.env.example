# PrepForge — Backend Environment Variables
#
# Copy this file to .env in this directory (backend/) and fill in values.
# The .env file is gitignored and must NEVER be committed.
#
#   cp .env.example .env
#
# ============================================================

# Deployment environment: development | staging | production
ENVIRONMENT=development

# API version prefix — matches the path used in all routes
API_PREFIX=/api/v1

# MongoDB connection URI
# Local:        mongodb://localhost:27017
# Atlas (free): mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
MONGODB_URL=mongodb://localhost:27017

# MongoDB database name — use different names per environment
DATABASE_NAME=prepforge_dev

# Comma-separated list of allowed CORS origins (your frontend URL)
# Default covers the Vite dev server on its default port
CORS_ORIGINS=http://localhost:5173

# ---- Added in Phase 4 (Authentication) ----
JWT_SECRET=super_secret_key_change_me_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
