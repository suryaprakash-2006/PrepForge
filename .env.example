# PrepForge — Environment Configuration Template
#
# INSTRUCTIONS:
#   1. Copy this file to .env in the backend/ directory.
#   2. Fill in the values appropriate for your environment.
#   3. NEVER commit the real .env file — it is .gitignored.
#   4. This file (.env.example) IS committed and version-controlled.
#
# Each variable is documented below with its purpose.
# ============================================================


# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------

# Deployment environment. One of: development | staging | production
ENVIRONMENT=development


# ------------------------------------------------------------
# BACKEND — FastAPI
# ------------------------------------------------------------

# API version prefix for all routes.
# Example: /api/v1
API_PREFIX=/api/v1

# Host and port for the Uvicorn development server.
# Change only if the default port 8000 is occupied.
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000


# ------------------------------------------------------------
# DATABASE — MongoDB
# ------------------------------------------------------------

# Full MongoDB connection URI.
# Local development example: mongodb://localhost:27017
# MongoDB Atlas example:     mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# Do NOT commit real credentials here.
MONGODB_URL=

# The name of the MongoDB database for this application.
# Use a separate database name for development, testing, and production.
DATABASE_NAME=prepforge_dev


# ------------------------------------------------------------
# AUTHENTICATION — JWT
# ------------------------------------------------------------

# Secret key used to sign and verify JWT tokens.
# Must be a long, random, unpredictable string.
# Generate one with: openssl rand -hex 32
# Or in Python:      python -c "import secrets; print(secrets.token_hex(32))"
# NEVER use a guessable value. NEVER commit the real value.
JWT_SECRET=

# JWT signing algorithm. HS256 is standard for single-server deployments.
JWT_ALGORITHM=HS256

# How long access tokens remain valid (in minutes).
# Shorter is more secure. 60 minutes is a reasonable starting point.
ACCESS_TOKEN_EXPIRE_MINUTES=60


# ------------------------------------------------------------
# FRONTEND — Vite
# ------------------------------------------------------------

# The base URL of the backend API, used by the React frontend.
# During local development this is typically http://localhost:8000
# This value is exposed to the browser — do NOT put secrets here.
VITE_API_BASE_URL=http://localhost:8000/api/v1
